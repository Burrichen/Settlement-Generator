{
  "schema_version": 1,
  "tables": [
    {
      "id": "table.authorityRole.council.member",
      "name": "Local Council Member Role",
      "description": "Treasurer and Civic Steward are unique; a second one becomes a Councillor.",
      "dice": "1d6",
      "results": [
        {
          "id": "role.council.councillor",
          "name": "Councillor",
          "range": [1, 3]
        },
        {
          "id": "role.council.communityRepresentative",
          "name": "Community Representative",
          "range": 4
        },
        {
          "id": "role.council.treasurer",
          "name": "Treasurer",
          "range": 5,
          "unique": true,
          "fallback": "role.council.councillor"
        },
        {
          "id": "role.council.civicSteward",
          "name": "Civic Steward",
          "range": 6,
          "unique": true,
          "fallback": "role.council.councillor"
        }
      ]
    }
  ]
}
