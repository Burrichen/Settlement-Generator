{
  "schema_version": 1,
  "tables": [
    {
      "id": "table.authority",
      "name": "Authority",
      "description": "Who officially governs the settlement: formal governance only, not hidden power, informal influence or factions.",
      "dice": "1d12",
      "results": [
        {
          "id": "council",
          "name": "Local Council",
          "description": "A small governing body formally handles settlement affairs.",
          "range": [1, 3],
          "tags": ["authority.council"],
          "generator": "authorityNpcs.council"
        },
        {
          "id": "noble",
          "name": "Noble / Landed Ruler",
          "description": "A hereditary, landed or aristocratic figure formally governs the settlement.",
          "range": [4, 5],
          "tags": ["authority.noble"],
          "generator": "authorityNpcs.noble"
        },
        {
          "id": "appointed",
          "name": "Appointed Official",
          "description": "An official placed in authority by a higher government or ruling institution.",
          "range": 6,
          "tags": ["authority.appointed"],
          "generator": "authorityNpcs.appointed"
        },
        {
          "id": "guild",
          "name": "Merchant / Guild Rule",
          "description": "A merchant body, trade organisation or guild formally governs the settlement.",
          "range": [7, 8],
          "tags": ["authority.guild"],
          "generator": "authorityNpcs.guild"
        },
        {
          "id": "religious",
          "name": "Religious Authority",
          "description": "A religious institution or recognised religious leader formally governs.",
          "range": 9,
          "tags": ["authority.religious"],
          "generator": "authorityNpcs.religious"
        },
        {
          "id": "military",
          "name": "Military Authority",
          "description": "A military commander or military institution formally governs.",
          "range": 10,
          "tags": ["authority.military"],
          "generator": "authorityNpcs.military"
        },
        {
          "id": "elders",
          "name": "Elders / Community Leaders",
          "description": "Formal authority rests with respected or established members of the community.",
          "range": 11,
          "tags": ["authority.elders"],
          "generator": "authorityNpcs.elders"
        },
        {
          "id": "assembly",
          "name": "Popular Assembly",
          "description": "Major settlement decisions are formally made collectively by a broad group of residents or recognised citizens.",
          "range": 12,
          "tags": ["authority.assembly"],
          "generator": "authorityNpcs.assembly"
        }
      ]
    }
  ],
