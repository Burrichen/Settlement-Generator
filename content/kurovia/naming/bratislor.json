{
  "schema_version": 1,
  "tables": [
    {
      "id": "table.naming.bratislor.method",
      "name": "Bratislor Naming Method",
      "description": "Which naming method a Bratislor settlement name uses. Each result is a naming method; its faces are its weight (starter weights 70% / 30%). Sombre old-settlement style; a fictional, language-inspired set, not a claim of accurate Slavic morphology.",
      "dice": "1d10",
      "results": [
        {
          "id": "geographic",
          "name": "Geographic Compound",
          "description": "First element + second element as one word, e.g. Drevgrad, Morava, Vranova.",
          "range": [1, 7]
        },
        {
          "id": "founder",
          "name": "Historical Founder",
          "description": "A founder's name joined directly to a settlement element, without an English possessive, e.g. Vorelgrad, Radanov.",
          "range": [8, 10]
        }
      ]
    },
