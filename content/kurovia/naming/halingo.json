{
  "schema_version": 1,
  "tables": [
    {
      "id": "table.naming.halingo.method",
      "name": "Halingo Naming Method",
      "description": "Which naming method a Halingo settlement name uses. Each result is a naming method; its faces are its weight (starter weights 70% / 30%). Arid frontier style: dry, understated and slightly harsh.",
      "dice": "1d10",
      "results": [
        {
          "id": "geographic",
          "name": "Geographic Compound",
          "description": "First element + second element as two words, e.g. Khar Well, Cinder Ridge.",
          "range": [1, 7]
        },
        {
          "id": "founder",
          "name": "Historical Founder",
          "description": "Founder's name + a settlement feature, e.g. Varesh's Well. A founder ending in s takes an apostrophe only.",
          "range": [8, 10]
        }
      ]
    },
