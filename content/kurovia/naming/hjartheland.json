      "id": "naming.kurovia.hjartheland",
      "name": "Hjartheland",
      "description": "Names for settlements in the Kurovian region of Hjartheland. Provisional sample data, not official Kurovian lore.",
      "when": {
        "all": [
          {
            "has_tag": "world.kurovia"
          },
          {
            "has_tag": "region.hjartheland"
          }
        ]
