  "naming_schemes": [
    {
      "id": "naming.kurovia.targoth",
      "name": "Targoth",
      "description": "Names for settlements in the Kurovian region of Targoth. Provisional sample data, not official Kurovian lore.",
      "when": {
        "all": [
          {
            "has_tag": "world.kurovia"
          },
          {
            "has_tag": "region.targoth"
          }
        ]
      },
      "method_table": "table.naming.targoth.method",
      "methods": [
        {
          "result": "geographic",
          "components": ["table.naming.targoth.firstElement", "table.naming.targoth.secondElement"],
          "join": {
            "style": "compound"
          }
        },
        {
          "result": "founder",
          "components": ["table.naming.targoth.founder", "table.naming.targoth.founderEnding"],
          "join": {
            "style": "possessive",
            "suffix": "'s",
            "separator": " ",
            "case": "words"
          }
        }
      ]
    }
  ]
