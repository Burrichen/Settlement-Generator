{
  "schema_version": 1,
  "naming_schemes": [
    {
      "id": "naming.kurovia.nareth",
      "name": "Nareth",
      "description": "Fictional rainforest and wetlands naming system drawing on selected real Quechua place-name concepts and original Ixtal-like hidden-civilisation fantasy; ten independently weighted methods. Known canon Uru Taal and Aruven excluded from the generator.",
      "when": {
        "all": [
          {
            "has_tag": "world.kurovia"
          },
          {
            "has_tag": "region.nareth"
          }
        ]
      },
      "method_table": "table.naming.nareth.method",
      "methods": [
        {
          "result": "river",
          "components": [
            "table.naming.nareth.riverFirst",
            "table.naming.nareth.riverSecond"
          ],
          "join": {
            "style": "compound"
          },
          "exceptions": []
        },
        {
          "result": "forest",
          "components": [
            "table.naming.nareth.forestFirst",
            "table.naming.nareth.forestSecond"
          ],
          "join": {
            "style": "compound"
          },
          "exceptions": []
        },
        {
