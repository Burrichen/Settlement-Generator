  "naming_schemes": [
    {
      "id": "naming.kurovia.skgurr",
      "name": "Skgurr",
      "description": "Names for settlements in the Kurovian region of Skgurr. Provisional sample data, not official Kurovian lore.",
      "when": {
        "all": [
          {
            "has_tag": "world.kurovia"
          },
          {
            "has_tag": "region.skgurr"
          }
        ]
      },
      "method_table": "table.naming.skgurr.method",
      "methods": [
        {
          "result": "geographic",
          "components": ["table.naming.skgurr.firstElement", "table.naming.skgurr.secondElement"],
          "join": {
            "style": "compound"
          }
        },
        {
          "result": "founder",
          "components": ["table.naming.skgurr.founder", "table.naming.skgurr.founderEnding"],
          "join": {
            "style": "possessive",
            "suffix": "'s",
            "separator": " ",
            "case": "words"
          }
        }
      ]
    }
  ]
