{
  "schema_version": 1,
  "flows": [
    {
      "id": "flow.ss.village.hardships",
      "name": "Village Hardships",
      "description": "Spectacular Settlements, Villages, Step 1: Hardship Likelihood (modified by Age) gives the number of hardships. Each rolls a Hardship Type and a Hardship Outcome; the outcome's penalty is taken from every later roll of the attributes that type lists (identical modifiers add up).",
      "steps": [
        {
          "id": "likelihood",
          "kind": "roll",
          "table": "table.ss.village.hardshipLikelihood",
          "name": "Hardship Likelihood"
        },
        {
          "id": "hardships",
          "kind": "repeat",
          "name": "Hardships",
          "count": {
            "value_of": {
              "step": "likelihood",
              "add": -1
            }
          },
          "steps": [
            {
              "id": "type",
              "kind": "roll",
              "table": "table.ss.village.hardshipType",
              "name": "Hardship Type"
            },
            {
              "id": "outcome",
              "kind": "roll",
              "table": "table.ss.village.hardshipOutcome",
              "name": "Hardship Outcome"
            },
            {
              "id": "losses",
              "kind": "branch",
              "name": "Losses",
              "cases": [
                {
                  "name": "Catastrophic: -5",
                  "when": {
                    "result_is": {
                      "step": "outcome",
                      "results": ["catastrophic"]
                    }
                  },
                  "steps": [
                    {
                      "id": "catastrophic-size",
                      "kind": "apply_modifier",
                      "name": "-5 to Size",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["raid", "harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.size",
                      "modifier": {
                        "minus": 5
                      }
                    },
                    {
                      "id": "catastrophic-condition",
                      "kind": "apply_modifier",
                      "name": "-5 to Condition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.condition",
                      "modifier": {
                        "minus": 5
                      }
                    },
                    {
                      "id": "catastrophic-density",
                      "kind": "apply_modifier",
                      "name": "-5 to Population Density",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["plague", "raid", "famine", "conflict", "war"]
                        }
                      },
                      "table": "table.ss.village.populationDensity",
                      "modifier": {
                        "minus": 5
                      }
                    },
                    {
                      "id": "catastrophic-disposition",
                      "kind": "apply_modifier",
                      "name": "-5 to Disposition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["conflict", "lossOfLeader"]
                        }
                      },
                      "table": "table.ss.village.disposition",
                      "modifier": {
                        "minus": 5
                      }
                    },
                    {
                      "id": "catastrophic-wealth",
                      "kind": "apply_modifier",
                      "name": "-5 to Population Wealth",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["bandits", "raid"]
                        }
                      },
                      "table": "table.ss.village.populationWealth",
                      "modifier": {
                        "minus": 5
                      }
                    }
                  ]
                },
                {
                  "name": "Terrible: -4",
                  "when": {
                    "result_is": {
                      "step": "outcome",
                      "results": ["terrible"]
                    }
                  },
                  "steps": [
                    {
                      "id": "terrible-size",
                      "kind": "apply_modifier",
                      "name": "-4 to Size",
                      "when": {
                        "result_is": {
