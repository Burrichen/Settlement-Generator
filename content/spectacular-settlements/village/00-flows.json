    {
      "id": "flow.ss.village.placesOfWorship",
      "name": "Village Places of Worship",
      "description": "Spectacular Settlements, Villages, Step 3: places of worship by size (Very Small 1, Small/Medium 1d2, Large/Very Large 1d2+1), each with its size, the fervency of its following and the alignment of its faith.",
      "steps": [
        {
          "id": "worshipCount",
          "kind": "branch",
          "name": "Places of worship by size",
          "cases": [
            {
              "name": "Very Small: 1",
              "when": {
                "has_tag": "ss.village.size.verySmall"
              },
              "steps": [
                {
                  "id": "worship-verySmall",
                  "kind": "repeat",
                  "name": "Places of worship",
                  "count": {
                    "times": 1
                  },
                  "steps": [
                    {
                      "id": "worshipSize-verySmall",
                      "kind": "roll",
                      "table": "table.ss.village.placeOfWorshipSize",
                      "name": "Place of Worship Size"
                    },
                    {
                      "id": "worshipFervency-verySmall",
                      "kind": "roll",
                      "table": "table.ss.village.fervency",
                      "name": "Fervency of Local Following"
                    },
                    {
                      "id": "worshipAlignment-verySmall",
                      "kind": "roll",
                      "table": "table.ss.village.faithAlignment",
                      "name": "Alignment of the Faith"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Small or Medium: 1d2",
              "when": {
                "any": [
                  {
                    "has_tag": "ss.village.size.small"
                  },
                  {
                    "has_tag": "ss.village.size.medium"
                  }
                ]
              },
              "steps": [
                {
                  "id": "worship-smallMedium",
                  "kind": "repeat",
                  "name": "Places of worship",
                  "count": {
                    "dice": "1d2"
                  },
                  "steps": [
                    {
                      "id": "worshipSize-smallMedium",
                      "kind": "roll",
                      "table": "table.ss.village.placeOfWorshipSize",
                      "name": "Place of Worship Size"
                    },
                    {
                      "id": "worshipFervency-smallMedium",
                      "kind": "roll",
                      "table": "table.ss.village.fervency",
                      "name": "Fervency of Local Following"
                    },
                    {
                      "id": "worshipAlignment-smallMedium",
                      "kind": "roll",
                      "table": "table.ss.village.faithAlignment",
                      "name": "Alignment of the Faith"
                    }
                  ]
                }
              ]
            },
            {
              "name": "Large or Very Large: 1d2 + 1",
              "when": {
                "any": [
                  {
                    "has_tag": "ss.village.size.large"
                  },
                  {
                    "has_tag": "ss.village.size.veryLarge"
                  }
                ]
              },
              "steps": [
                {
                  "id": "worship-large",
                  "kind": "repeat",
                  "name": "Places of worship",
                  "count": {
                    "dice": "1d2+1"
                  },
                  "steps": [
                    {
                      "id": "worshipSize-large",
                      "kind": "roll",
                      "table": "table.ss.village.placeOfWorshipSize",
                      "name": "Place of Worship Size"
                    },
                    {
                      "id": "worshipFervency-large",
                      "kind": "roll",
                      "table": "table.ss.village.fervency",
                      "name": "Fervency of Local Following"
                    },
                    {
                      "id": "worshipAlignment-large",
                      "kind": "roll",
                      "table": "table.ss.village.faithAlignment",
                      "name": "Alignment of the Faith"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
