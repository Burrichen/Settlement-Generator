                      "modifier": {
                        "minus": 4
                      }
                    },
                    {
                      "id": "terrible-condition",
                      "kind": "apply_modifier",
                      "name": "-4 to Condition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.condition",
                      "modifier": {
                        "minus": 4
                      }
                    },
                    {
                      "id": "terrible-density",
                      "kind": "apply_modifier",
                      "name": "-4 to Population Density",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["plague", "raid", "famine", "conflict", "war"]
                        }
                      },
                      "table": "table.ss.village.populationDensity",
                      "modifier": {
                        "minus": 4
                      }
                    },
                    {
                      "id": "terrible-disposition",
                      "kind": "apply_modifier",
                      "name": "-4 to Disposition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["conflict", "lossOfLeader"]
                        }
                      },
                      "table": "table.ss.village.disposition",
                      "modifier": {
                        "minus": 4
                      }
                    },
                    {
                      "id": "terrible-wealth",
                      "kind": "apply_modifier",
                      "name": "-4 to Population Wealth",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["bandits", "raid"]
                        }
                      },
                      "table": "table.ss.village.populationWealth",
                      "modifier": {
                        "minus": 4
                      }
                    }
                  ]
                },
                {
                  "name": "Heavy: -3",
                  "when": {
                    "result_is": {
                      "step": "outcome",
                      "results": ["heavy"]
                    }
                  },
                  "steps": [
                    {
                      "id": "heavy-size",
                      "kind": "apply_modifier",
                      "name": "-3 to Size",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["raid", "harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.size",
                      "modifier": {
                        "minus": 3
                      }
                    },
                    {
                      "id": "heavy-condition",
                      "kind": "apply_modifier",
                      "name": "-3 to Condition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.condition",
                      "modifier": {
                        "minus": 3
                      }
                    },
                    {
                      "id": "heavy-density",
                      "kind": "apply_modifier",
                      "name": "-3 to Population Density",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["plague", "raid", "famine", "conflict", "war"]
                        }
                      },
                      "table": "table.ss.village.populationDensity",
                      "modifier": {
                        "minus": 3
                      }
                    },
                    {
                      "id": "heavy-disposition",
                      "kind": "apply_modifier",
                      "name": "-3 to Disposition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["conflict", "lossOfLeader"]
                        }
                      },
                      "table": "table.ss.village.disposition",
                      "modifier": {
                        "minus": 3
                      }
                    },
                    {
                      "id": "heavy-wealth",
