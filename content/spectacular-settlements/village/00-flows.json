                    },
                    {
                      "id": "moderate-condition",
                      "kind": "apply_modifier",
                      "name": "-2 to Condition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["harshWeather", "war"]
                        }
                      },
                      "table": "table.ss.village.condition",
                      "modifier": {
                        "minus": 2
                      }
                    },
                    {
                      "id": "moderate-density",
                      "kind": "apply_modifier",
                      "name": "-2 to Population Density",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["plague", "raid", "famine", "conflict", "war"]
                        }
                      },
                      "table": "table.ss.village.populationDensity",
                      "modifier": {
                        "minus": 2
                      }
                    },
                    {
                      "id": "moderate-disposition",
                      "kind": "apply_modifier",
                      "name": "-2 to Disposition",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["conflict", "lossOfLeader"]
                        }
                      },
                      "table": "table.ss.village.disposition",
                      "modifier": {
                        "minus": 2
                      }
                    },
                    {
                      "id": "moderate-wealth",
                      "kind": "apply_modifier",
                      "name": "-2 to Population Wealth",
                      "when": {
                        "result_is": {
                          "step": "type",
                          "results": ["bandits", "raid"]
                        }
                      },
                      "table": "table.ss.village.populationWealth",
                      "modifier": {
                        "minus": 2
                      }
                    }
                  ]
                },
                {
                  "name": "Minimal: -1",
                  "when": {
                    "result_is": {
