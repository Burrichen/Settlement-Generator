{
  "schema_version": 1,
  "tables": [
    {
      "id": "table.ss.capital.explorationState",
      "name": "Exploration",
      "description": "Outside the Capital's exploration: 1-3 still active, 4-6 abandoned or completed.",
      "dice": "1d6",
      "results": [
        {
          "id": "active",
          "name": "Still Active",
          "range": [1, 3],
          "description": "The exploration is still active.",
          "tags": ["ss.capital.explorationState.active"]
        },
        {
          "id": "ended",
          "name": "Abandoned/Completed",
          "range": [4, 6],
          "description": "It has been abandoned/completed.",
          "tags": ["ss.capital.explorationState.ended"]
        }
      ]
    }
  ],
  "tags": [
    {
      "id": "ss.capital.explorationState.active",
      "name": "Still Active"
    },
    {
      "id": "ss.capital.explorationState.ended",
      "name": "Abandoned/Completed"
    }
  ]
}
