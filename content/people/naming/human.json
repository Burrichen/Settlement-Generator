  "naming_schemes": [
    {
      "id": "naming.person.human.masculine",
      "name": "Human names (masculine)",
      "subject": "person",
      "when": {
        "all": [
          {
            "has_tag": "species.human"
          },
          {
            "has_tag": "gender.man"
          }
        ]
      },
      "method_table": "table.personName.human.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": ["table.personName.human.given.masculine", "table.personName.human.family"],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "family",
              "label": "Family name"
            }
          ]
        }
      ]
    },
    {
      "id": "naming.person.human.feminine",
      "name": "Human names (feminine)",
