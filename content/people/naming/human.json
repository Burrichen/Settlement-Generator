          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "family",
              "label": "Family name"
            }
          ]
        }
      ]
    },
    {
      "id": "naming.person.human.neutral",
