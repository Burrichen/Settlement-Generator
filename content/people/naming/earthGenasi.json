  "naming_schemes": [
    {
      "id": "naming.person.earthGenasi",
      "name": "Earth Genasi names",
      "subject": "person",
      "when": {
        "has_tag": "species.earthGenasi"
      },
      "method_table": "table.personName.earthGenasi.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": [
            "table.personName.earthGenasi.given",
            "table.personName.earthGenasi.byname"
          ],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "byname",
              "label": "Byname"
            }
          ]
        }
      ],
      "description": "Earth genasi pair a given name with a byname drawn from stone and the deep earth."
    }
  ]
