          },
          {
            "has_tag": "gender.woman"
          }
        ]
      },
      "method_table": "table.personName.woodElf.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": ["table.personName.woodElf.given.feminine", "table.personName.woodElf.kin"],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "kin",
              "label": "Kin name"
            }
          ]
        }
      ]
    },
