            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "lineage",
              "label": "Lineage name"
            }
          ]
        }
      ]
    }
  ]
}
