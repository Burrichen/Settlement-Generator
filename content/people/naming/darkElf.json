  "naming_schemes": [
    {
      "id": "naming.person.darkElf.masculine",
      "name": "Dark Elf names (masculine)",
      "subject": "person",
      "when": {
        "all": [
          {
            "has_tag": "species.darkElf"
          },
          {
            "has_tag": "gender.man"
          }
        ]
      },
      "method_table": "table.personName.darkElf.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": [
            "table.personName.darkElf.given.masculine",
            "table.personName.darkElf.house"
          ],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "house",
              "label": "House name"
            }
          ]
        }
      ]
    },
