  "naming_schemes": [
    {
      "id": "naming.person.yuanTi",
      "name": "Yuan-Ti names",
      "subject": "person",
      "when": {
        "has_tag": "species.yuanTi"
      },
      "method_table": "table.personName.yuanTi.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": ["table.personName.yuanTi.given", "table.personName.yuanTi.lineage"],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "lineage",
              "label": "Lineage name"
            }
          ]
        }
      ]
    }
  ]
