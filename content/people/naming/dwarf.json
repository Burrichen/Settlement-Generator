  "naming_schemes": [
    {
      "id": "naming.person.dwarf.masculine",
      "name": "Dwarf names (masculine)",
      "subject": "person",
      "when": {
        "all": [
          {
            "has_tag": "species.dwarf"
          },
          {
            "has_tag": "gender.man"
          }
        ]
      },
      "method_table": "table.personName.dwarf.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": ["table.personName.dwarf.given.masculine", "table.personName.dwarf.clan"],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "clan",
              "label": "Clan name"
            }
          ]
        }
      ]
    },
    {
