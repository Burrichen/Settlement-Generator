  "naming_schemes": [
    {
      "id": "naming.person.highElf.masculine",
      "name": "High Elf names (masculine)",
      "subject": "person",
      "when": {
        "all": [
          {
            "has_tag": "species.highElf"
          },
          {
            "has_tag": "gender.man"
          }
        ]
      },
      "method_table": "table.personName.highElf.method",
      "methods": [
        {
          "result": "givenSurname",
          "components": [
            "table.personName.highElf.given.masculine",
            "table.personName.highElf.house"
          ],
          "join": {
            "style": "compound",
            "separator": " ",
            "case": "as_written"
          },
          "parts": [
            {
              "id": "given",
              "label": "Given name"
            },
            {
              "id": "house",
              "label": "House name"
            }
          ]
        }
      ]
    },
