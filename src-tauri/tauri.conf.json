{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Settlement Generator",
  "mainBinaryName": "settlement-generator",
  "identifier": "com.settlement-generator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Settlement Generator",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Generate tabletop settlements from physical-dice tables",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNkM5MjUwM0U5NzQwNTYKUldSV1FKYytVSkpzTEJVbFpEQ3hlZW1TenpJb0tNVTRZdlRTUENxWmNyUzJJMFBzZjdmWU04T1IK",
      "endpoints": [
        "https://github.com/Burrichen/Settlement-Generator/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
